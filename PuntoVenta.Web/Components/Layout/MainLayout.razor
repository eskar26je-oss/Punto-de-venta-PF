@inherits LayoutComponentBase
@inject SesionUsuario Sesion
@inject NavigationManager Nav

@if (Sesion.EstaAutenticado)
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                <span>Usuario: <strong>@Sesion.Usuario</strong></span>
            </div>

            @* "solo-lectura" esconde los botones de crear, editar y eliminar *@
            <article class="content px-4 @(SoloLectura ? "solo-lectura" : "")">
                @if (PuedeVerPagina)
                {
                    @Body
                }
                else
                {
                    <div class="alert alert-warning mt-3">
                        No tienes permiso para ver esta sección. Pide acceso al administrador.
                    </div>
                }
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string RutaActual => "/" + Nav.ToBaseRelativePath(Nav.Uri);

    private bool PuedeVerPagina => Sesion.PuedeVer(RutaActual);

    // Los reportes solo se consultan, por eso nunca se ponen en solo lectura
    private bool SoloLectura =>
        SesionUsuario.RutaModulo(RutaActual) != "/reportes" && !Sesion.PuedeEditar(RutaActual);

    protected override async Task OnInitializedAsync()
    {
        await Sesion.RestaurarAsync();

        if (!Sesion.EstaAutenticado)
        {
            Nav.NavigateTo("/login");
        }
    }
}
