@inject HttpClient Http
@inject SesionUsuario Sesion
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Punto de Venta</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @foreach (var opcion in menu.OrderBy(m => m.Orden))
        {
            <ElementoMenu Item="opcion" />
        }

        <div class="nav-item px-3">
            <button class="nav-link" @onclick="CerrarSesion">
                <span class="bi" aria-hidden="true"></span> Cerrar sesión
            </button>
        </div>
    </nav>
</div>

@code {
    private List<ElementoMenu.MenuModel> menu = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var respuesta = await Http.GetAsync("Menu");
            if (respuesta.IsSuccessStatusCode)
            {
                menu = await respuesta.Content.ReadFromJsonAsync<List<ElementoMenu.MenuModel>>() ?? new();
            }
        }
        catch
        {
        }
    }

    private void CerrarSesion()
    {
        Sesion.Cerrar();
        Nav.NavigateTo("/login");
    }
}