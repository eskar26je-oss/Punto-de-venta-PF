@page "/productos"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Hosting
@inject HttpClient Http
@inject SesionUsuario Sesion
@inject NavigationManager Nav
@inject IWebHostEnvironment Entorno

<PageTitle>Productos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Productos</h3>
    <a class="btn btn-outline-secondary btn-sm" href="marcas">Ir a Marcas</a>
</div>

@if (mensajeError is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (mensajeOk is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeOk
        <button type="button" class="btn-close" @onclick="() => mensajeOk = null"></button>
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input class="form-control" placeholder="Buscar por código, producto, marca o descripción..."
               @bind="Buscar" @bind:event="oninput" />
    </div>
    <div class="col-md-6 text-md-end">
        <button class="btn btn-primary" @onclick="AbrirModalNuevo">Nuevo producto</button>
    </div>
</div>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Foto</th>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Marca</th>
                    <th class="text-end">Costo</th>
                    <th class="text-end">Venta</th>
                    <th class="text-end">Existencia</th>
                    <th>Ingreso</th>
                    <th class="text-center" style="width: 190px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!ProductosPagina.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted">No hay productos para mostrar</td>
                    </tr>
                }
                else
                {
                    @foreach (var producto in ProductosPagina)
                    {
                        <tr>
                            <td style="width: 80px;">
                                @if (!string.IsNullOrEmpty(producto.Imagen))
                                {
                                    <img src="@producto.Imagen" alt="@producto.Producto" class="rounded" style="height: 48px; max-width: 64px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="text-muted small">Sin foto</span>
                                }
                            </td>
                            <td>@producto.IdProducto</td>
                            <td>
                                <div>@producto.Producto</div>
                                <div class="text-muted small">@producto.Descripcion</div>
                            </td>
                            <td>@NombreMarca(producto.IdMarca)</td>
                            <td class="text-end">Q @producto.PrecioCosto.ToString("N2")</td>
                            <td class="text-end">Q @producto.PrecioVenta.ToString("N2")</td>
                            <td class="text-end">@producto.Existencia</td>
                            <td>@producto.FechaIngreso.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-warning me-1" @onclick="() => AbrirModalEditar(producto)">Editar</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => PedirConfirmacionEliminar(producto)">Eliminar</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (TotalPaginas > 1)
    {
        <nav aria-label="Paginación de productos">
            <ul class="pagination justify-content-center">
                <li class="@ClaseItem(paginaActual == 1, false)">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual - 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= TotalPaginas; i++)
                {
                    var numeroPagina = i;
                    <li class="@ClaseItem(false, numeroPagina == paginaActual)">
                        <button class="page-link" @onclick="() => IrAPagina(numeroPagina)">@numeroPagina</button>
                    </li>
                }
                <li class="@ClaseItem(paginaActual == TotalPaginas, false)">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}
@if (mostrarModal)
{
    <div class="modal fade show" style="display:block; overflow-y:auto;" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <EditForm Model="productoActual" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />

                    <div class="modal-header">
                        <h5 class="modal-title">@(esEdicion ? "Editar producto" : "Nuevo producto")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body">
                        @if (errorModal is not null)
                        {
                            <div class="alert alert-danger">@errorModal</div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Producto</label>
                                <InputText class="form-control" @bind-Value="productoActual.Producto" />
                                <ValidationMessage For="() => productoActual.Producto" class="text-danger small" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="d-flex justify-content-between">
                                    <label class="form-label">Marca</label>
                                    <a href="marcas" class="small">Administrar marcas</a>
                                </div>
                                <InputSelect class="form-select" @bind-Value="productoActual.IdMarca">
                                    <option value="0">-- Seleccione una marca --</option>
                                    @foreach (var marca in marcas)
                                    {
                                        <option value="@marca.IdMarca">@marca.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => productoActual.IdMarca" class="text-danger small" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <InputText class="form-control" @bind-Value="productoActual.Descripcion" />
                            <ValidationMessage For="() => productoActual.Descripcion" class="text-danger small" />
                        </div>
                                                <div class="mb-3">
                            <label class="form-label">Foto del producto</label>
                            <InputFile class="form-control" accept=".jpg,.jpeg,.png,.webp" OnChange="SeleccionarImagen" />
                            <div class="form-text">JPG, PNG o WEBP, máximo 2 MB.</div>
                            @if (!string.IsNullOrEmpty(productoActual.Imagen))
                            {
                                <div class="mt-2">
                                    <img src="@productoActual.Imagen" alt="Vista previa" class="rounded border" style="max-height: 120px;" />
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="QuitarImagen">Quitar foto</button>
                                </div>
                            }
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Precio de costo (Q)</label>
                                <InputNumber class="form-control" step="0.01" ParsingErrorMessage="El precio de costo debe ser un número"
                                             @bind-Value="productoActual.PrecioCosto" @bind-Value:after="CalcularVenta" />
                                <ValidationMessage For="() => productoActual.PrecioCosto" class="text-danger small" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Precio de venta (Q)</label>
                                <InputNumber class="form-control" step="0.01" ParsingErrorMessage="El precio de venta debe ser un número"
                                             @bind-Value="productoActual.PrecioVenta" />
                                <div class="form-text">Se sugiere costo + 25 %. Puede ajustarlo.</div>
                                <ValidationMessage For="() => productoActual.PrecioVenta" class="text-danger small" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Existencia</label>
                                <InputNumber class="form-control" step="1" ParsingErrorMessage="La existencia debe ser un número entero"
                                             @bind-Value="productoActual.Existencia" />
                                <ValidationMessage For="() => productoActual.Existencia" class="text-danger small" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha de ingreso</label>
                               <CampoFecha Value="productoActual.FechaIngreso"
            ValueChanged="@((DateTime? v) => productoActual.FechaIngreso = v ?? DateTime.Today)" />
                                <ValidationMessage For="() => productoActual.FechaIngreso" class="text-danger small" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
@if (mostrarConfirmacionEliminar)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que deseas eliminar el producto <strong>@productoAEliminar?.Producto</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar" disabled="@eliminando">
                        @(eliminando ? "Eliminando..." : "Eliminar")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private static readonly string[] extensionesPermitidas = { ".jpg", ".jpeg", ".png", ".webp" };
    private const long tamanoMaximoImagen = 2 * 1024 * 1024;

    private List<ProductoModel> productos = new();
    private List<MarcaModel> marcas = new();
    private ProductoModel productoActual = new();
    private ProductoModel? productoAEliminar;
    private string? imagenOriginal;

    private bool mostrarModal;
    private bool mostrarConfirmacionEliminar;
    private bool esEdicion;
    private bool cargando = true;
    private bool guardando;
    private bool eliminando;

    private string? mensajeError;
    private string? mensajeOk;
    private string? errorModal;

    private string _buscar = "";
    private string Buscar
    {
        get => _buscar;
        set { _buscar = value; paginaActual = 1; }
    }

    private int paginaActual = 1;
    private const int tamanoPagina = 5;

    private IEnumerable<ProductoModel> Filtrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Buscar)) return productos;

            var texto = Buscar.Trim();
            return productos.Where(p =>
                p.IdProducto.ToString() == texto
                || p.Producto.Contains(texto, StringComparison.OrdinalIgnoreCase)
                || NombreMarca(p.IdMarca).Contains(texto, StringComparison.OrdinalIgnoreCase)
                || (p.Descripcion ?? "").Contains(texto, StringComparison.OrdinalIgnoreCase));
        }
    }

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(Filtrados.Count() / (double)tamanoPagina));

    private IEnumerable<ProductoModel> ProductosPagina =>
        Filtrados.Skip((paginaActual - 1) * tamanoPagina).Take(tamanoPagina);

    private string NombreMarca(short idMarca)
    {
        return marcas.FirstOrDefault(m => m.IdMarca == idMarca)?.Nombre ?? "-";
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarMarcas();
        await CargarProductos();
    }

    private async Task CargarMarcas()
    {
        try
        {
            var respuesta = await Http.GetAsync("Marcas");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                marcas = await respuesta.Content.ReadFromJsonAsync<List<MarcaModel>>() ?? new();
            }
        }
        catch
        {
        }
    }

    private async Task CargarProductos()
    {
        cargando = true;
        try
        {
            var respuesta = await Http.GetAsync("Productos");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                productos = await respuesta.Content.ReadFromJsonAsync<List<ProductoModel>>() ?? new();
            }
            else
            {
                mensajeError = "No se pudieron cargar los productos.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private bool SesionVencida(HttpResponseMessage respuesta)
    {
        if (respuesta.StatusCode != System.Net.HttpStatusCode.Unauthorized) return false;

        Sesion.Cerrar();
        Nav.NavigateTo("/login");
        return true;
    }

    private static string ClaseItem(bool desactivado, bool activo)
    {
        var clase = "page-item";
        if (desactivado) clase += " disabled";
        if (activo) clase += " active";
        return clase;
    }

    private void IrAPagina(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas) return;
        paginaActual = pagina;
    }
    private void CalcularVenta()
    {
        productoActual.PrecioVenta = Math.Round(productoActual.PrecioCosto * 1.25m, 2);
    }

    private void AbrirModalNuevo()
    {
        productoActual = new ProductoModel();
        imagenOriginal = null;
        esEdicion = false;
        errorModal = null;
        mostrarModal = true;
    }

    private void AbrirModalEditar(ProductoModel producto)
    {
        productoActual = new ProductoModel
        {
            IdProducto = producto.IdProducto,
            Producto = producto.Producto,
            IdMarca = producto.IdMarca,
            Descripcion = producto.Descripcion,
            Imagen = producto.Imagen,
            PrecioCosto = producto.PrecioCosto,
            PrecioVenta = producto.PrecioVenta,
            Existencia = producto.Existencia,
            FechaIngreso = producto.FechaIngreso
        };
        imagenOriginal = producto.Imagen;
        esEdicion = true;
        errorModal = null;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        if (productoActual.Imagen != imagenOriginal) BorrarArchivo(productoActual.Imagen);
        mostrarModal = false;
    }

    private async Task SeleccionarImagen(InputFileChangeEventArgs e)
    {
        errorModal = null;
        var archivo = e.File;
        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();

        if (!extensionesPermitidas.Contains(extension))
        {
            errorModal = "Solo se permiten imágenes JPG, PNG o WEBP.";
            return;
        }

        if (archivo.Size > tamanoMaximoImagen)
        {
            errorModal = "La imagen no puede pesar más de 2 MB.";
            return;
        }

        try
        {
            var carpeta = CarpetaFotos();
            Directory.CreateDirectory(carpeta);

            var nombre = Guid.NewGuid().ToString("N").Substring(0, 7) + extension;
            var rutaCompleta = Path.Combine(carpeta, nombre);

            await using (var origen = archivo.OpenReadStream(tamanoMaximoImagen))
            await using (var destino = File.Create(rutaCompleta))
            {
                await origen.CopyToAsync(destino);
            }

            if (productoActual.Imagen != imagenOriginal) BorrarArchivo(productoActual.Imagen);
            productoActual.Imagen = "/images/productos/" + nombre;
        }
        catch (Exception ex)
        {
            errorModal = $"No se pudo guardar la imagen: {ex.Message}";
        }
    }
    private string CarpetaFotos()
    {
        return Path.GetFullPath(Path.Combine(Entorno.ContentRootPath, "..", "FotosProductos"));
    }
    private void QuitarImagen()
    {
        if (productoActual.Imagen != imagenOriginal) BorrarArchivo(productoActual.Imagen);
        productoActual.Imagen = null;
    }

    private void BorrarArchivo(string? ruta)
    {
        if (string.IsNullOrEmpty(ruta)) return;

        try
        {
            var nombre = Path.GetFileName(ruta);
           var rutaCompleta = Path.Combine(CarpetaFotos(), nombre);
            if (File.Exists(rutaCompleta)) File.Delete(rutaCompleta);
        }
        catch
        {
        }
    }
        private async Task Guardar()
    {
        guardando = true;
        errorModal = null;
        mensajeOk = null;
        try
        {
            HttpResponseMessage respuesta = esEdicion
                ? await Http.PutAsJsonAsync($"Productos/{productoActual.IdProducto}", productoActual)
                : await Http.PostAsJsonAsync("Productos", productoActual);

            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                if (imagenOriginal != productoActual.Imagen) BorrarArchivo(imagenOriginal);
                mostrarModal = false;
                mensajeOk = esEdicion ? "Producto actualizado correctamente." : "Producto creado correctamente.";
                await CargarProductos();
            }
            else
            {
                errorModal = await LeerMensaje(respuesta, "No se pudo guardar el producto. Verifica los datos.");
            }
        }
        catch (Exception ex)
        {
            errorModal = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void PedirConfirmacionEliminar(ProductoModel producto)
    {
        productoAEliminar = producto;
        mostrarConfirmacionEliminar = true;
    }

    private void CancelarEliminar()
    {
        productoAEliminar = null;
        mostrarConfirmacionEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        if (productoAEliminar is null) return;

        eliminando = true;
        mensajeOk = null;
        try
        {
            var respuesta = await Http.DeleteAsync($"Productos/{productoAEliminar.IdProducto}");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                BorrarArchivo(productoAEliminar.Imagen);
                mensajeOk = "Producto eliminado correctamente.";
                await CargarProductos();
                if (paginaActual > TotalPaginas) paginaActual = TotalPaginas;
            }
            else
            {
                mensajeError = await LeerMensaje(respuesta, "No se pudo eliminar el producto.");
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al eliminar: {ex.Message}";
        }
        finally
        {
            eliminando = false;
            mostrarConfirmacionEliminar = false;
            productoAEliminar = null;
        }
    }

    private static async Task<string> LeerMensaje(HttpResponseMessage respuesta, string porDefecto)
    {
        try
        {
            var error = await respuesta.Content.ReadFromJsonAsync<ErrorApi>();
            if (!string.IsNullOrWhiteSpace(error?.Mensaje)) return error.Mensaje!;
        }
        catch
        {
        }
        return porDefecto;
    }

    private record ErrorApi(string? Mensaje);

    public class MarcaModel
    {
        public short IdMarca { get; set; }
        public string Nombre { get; set; } = "";
    }

    public class ProductoModel : IValidatableObject
    {
        public int IdProducto { get; set; }

        [Required(ErrorMessage = "El nombre del producto es obligatorio")]
        [StringLength(50, ErrorMessage = "Máximo 50 caracteres")]
        public string Producto { get; set; } = "";

        [Range(1, short.MaxValue, ErrorMessage = "Seleccione una marca")]
        public short IdMarca { get; set; }

        [StringLength(100, ErrorMessage = "Máximo 100 caracteres")]
        public string? Descripcion { get; set; }

        public string? Imagen { get; set; }

        [Range(0.01, 999999.99, ErrorMessage = "El precio de costo debe ser mayor a cero")]
        public decimal PrecioCosto { get; set; }

        [Range(0.01, 999999.99, ErrorMessage = "El precio de venta debe ser mayor a cero")]
        public decimal PrecioVenta { get; set; }

        [Range(0, int.MaxValue, ErrorMessage = "La existencia no puede ser negativa")]
        public int Existencia { get; set; }

        public DateTime FechaIngreso { get; set; } = DateTime.Today;

        public IEnumerable<ValidationResult> Validate(ValidationContext contexto)
        {
            if (PrecioVenta < PrecioCosto)
            {
                yield return new ValidationResult(
                    "El precio de venta no puede ser menor al precio de costo.",
                    new[] { nameof(PrecioVenta) });
            }

            if (FechaIngreso.Date > DateTime.Today)
            {
                yield return new ValidationResult(
                    "La fecha de ingreso no puede ser futura.",
                    new[] { nameof(FechaIngreso) });
            }

            if (FechaIngreso.Year < 2000)
            {
                yield return new ValidationResult(
                    "La fecha de ingreso no es válida.",
                    new[] { nameof(FechaIngreso) });
            }
        }
    }
}