@page "/clientes"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject SesionUsuario Sesion
@inject NavigationManager Nav

<PageTitle>Clientes</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Clientes</h3>
    <a class="btn btn-outline-secondary btn-sm" href="ventas">Ir a Ventas</a>
</div>

@if (mensajeError is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (mensajeOk is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeOk
        <button type="button" class="btn-close" @onclick="() => mensajeOk = null"></button>
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input class="form-control" placeholder="Buscar por nombre, NIT, teléfono o correo..."
               @bind="Buscar" @bind:event="oninput" />
    </div>
    <div class="col-md-6 text-md-end">
        <button class="btn btn-primary" @onclick="AbrirModalNuevo">Nuevo cliente</button>
    </div>
</div>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>NIT</th>
                    <th>Género</th>
                    <th>Teléfono</th>
                    <th>Correo electrónico</th>
                    <th class="text-center" style="width: 170px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!ClientesPagina.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No hay clientes para mostrar</td>
                    </tr>
                }
                else
                {
                    @foreach (var cliente in ClientesPagina)
                    {
                        <tr>
                            <td>@cliente.IdCliente</td>
                            <td>@cliente.Nombres @cliente.Apellidos</td>
                            <td>@cliente.Nit</td>
                            <td>@(cliente.Genero == 1 ? "Masculino" : "Femenino")</td>
                            <td>@(cliente.Telefono ?? "-")</td>
                            <td>@(cliente.CorreoElectronico ?? "-")</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-warning me-1" @onclick="() => autorizacion.Ejecutar(Recurso, cliente.IdCliente, () => AbrirModalEditar(cliente))">Editar</button>
<button class="btn btn-sm btn-danger" @onclick="() => autorizacion.Ejecutar(Recurso, cliente.IdCliente, () => PedirConfirmacionEliminar(cliente))">Eliminar</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (TotalPaginas > 1)
    {
        <nav aria-label="Paginación de clientes">
            <ul class="pagination justify-content-center">
                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual - 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= TotalPaginas; i++)
                {
                    var numeroPagina = i;
                    <li class="page-item @(numeroPagina == paginaActual ? "active" : "")">
                        <button class="page-link" @onclick="() => IrAPagina(numeroPagina)">@numeroPagina</button>
                    </li>
                }
                <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}

@if (mostrarModal)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <EditForm Model="clienteActual" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />

                    <div class="modal-header">
                        <h5 class="modal-title">@(esEdicion ? "Editar cliente" : "Nuevo cliente")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body">
                        @if (errorModal is not null)
                        {
                            <div class="alert alert-danger">@errorModal</div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombres</label>
                                <InputText class="form-control" maxlength="60" @bind-Value="clienteActual.Nombres" />
                                <ValidationMessage For="() => clienteActual.Nombres" class="text-danger small" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Apellidos</label>
                                <InputText class="form-control" maxlength="60" @bind-Value="clienteActual.Apellidos" />
                                <ValidationMessage For="() => clienteActual.Apellidos" class="text-danger small" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">NIT</label>
                                <InputText class="form-control" maxlength="12" placeholder="Ej. 1234567-8 o CF"
                                           @bind-Value="clienteActual.Nit" />
                                <ValidationMessage For="() => clienteActual.Nit" class="text-danger small" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Género</label>
                                <InputSelect class="form-select" @bind-Value="clienteActual.GeneroSeleccion">
                                    <option value="">-- Seleccione --</option>
                                    <option value="1">Masculino</option>
                                    <option value="0">Femenino</option>
                                </InputSelect>
                                <ValidationMessage For="() => clienteActual.GeneroSeleccion" class="text-danger small" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" maxlength="8" placeholder="8 dígitos (opcional)"
                                           @bind-Value="clienteActual.Telefono" />
                                <ValidationMessage For="() => clienteActual.Telefono" class="text-danger small" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Correo electrónico</label>
                                <InputText class="form-control" maxlength="45" placeholder="Opcional"
                                           @bind-Value="clienteActual.CorreoElectronico" />
                                <ValidationMessage For="() => clienteActual.CorreoElectronico" class="text-danger small" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (mostrarConfirmacionEliminar)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que deseas eliminar al cliente <strong>@(clienteAEliminar?.Nombres) @(clienteAEliminar?.Apellidos)</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar" disabled="@eliminando">
                        @(eliminando ? "Eliminando..." : "Eliminar")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
<AutorizacionAdmin @ref="autorizacion" />
@code {
    private AutorizacionAdmin autorizacion = default!;
private const string Recurso = "clientes";
    private List<ClienteModel> clientes = new();
    private ClienteModel clienteActual = new();
    private ClienteModel? clienteAEliminar;

    private bool mostrarModal;
    private bool mostrarConfirmacionEliminar;
    private bool esEdicion;
    private bool cargando = true;
    private bool guardando;
    private bool eliminando;

    private string? mensajeError;
    private string? mensajeOk;
    private string? errorModal;

    private string _buscar = "";
    private string Buscar
    {
        get => _buscar;
        set { _buscar = value; paginaActual = 1; }
    }

    private int paginaActual = 1;
    private const int tamanoPagina = 5;

    private IEnumerable<ClienteModel> Filtrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Buscar)) return clientes;

            var texto = Buscar.Trim();
            return clientes.Where(c =>
                c.IdCliente.ToString() == texto
                || $"{c.Nombres} {c.Apellidos}".Contains(texto, StringComparison.OrdinalIgnoreCase)
                || c.Nit.Contains(texto, StringComparison.OrdinalIgnoreCase)
                || (c.Telefono ?? "").Contains(texto)
                || (c.CorreoElectronico ?? "").Contains(texto, StringComparison.OrdinalIgnoreCase));
        }
    }

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(Filtrados.Count() / (double)tamanoPagina));

    private IEnumerable<ClienteModel> ClientesPagina =>
        Filtrados.Skip((paginaActual - 1) * tamanoPagina).Take(tamanoPagina);

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        cargando = true;
        try
        {
            var respuesta = await Http.GetAsync("Clientes");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                clientes = await respuesta.Content.ReadFromJsonAsync<List<ClienteModel>>() ?? new();
            }
            else
            {
                mensajeError = "No se pudieron cargar los clientes.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private bool SesionVencida(HttpResponseMessage respuesta)
    {
        if (respuesta.StatusCode != System.Net.HttpStatusCode.Unauthorized) return false;

        Sesion.Cerrar();
        Nav.NavigateTo("/login");
        return true;
    }

    private void IrAPagina(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas) return;
        paginaActual = pagina;
    }

    private void AbrirModalNuevo()
    {
        clienteActual = new ClienteModel();
        esEdicion = false;
        errorModal = null;
        mostrarModal = true;
    }

    private void AbrirModalEditar(ClienteModel cliente)
    {
        clienteActual = new ClienteModel
        {
            IdCliente = cliente.IdCliente,
            Nombres = cliente.Nombres,
            Apellidos = cliente.Apellidos,
            Nit = cliente.Nit,
            Genero = cliente.Genero,
            Telefono = cliente.Telefono,
            CorreoElectronico = cliente.CorreoElectronico,
            FechaIngreso = cliente.FechaIngreso
        };
        esEdicion = true;
        errorModal = null;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task Guardar()
    {
        guardando = true;
        errorModal = null;
        mensajeOk = null;
        try
        {
            HttpResponseMessage respuesta = esEdicion
                ? await Http.PutAsJsonAsync($"Clientes/{clienteActual.IdCliente}", clienteActual)
                : await Http.PostAsJsonAsync("Clientes", clienteActual);

            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                mostrarModal = false;
                mensajeOk = esEdicion ? "Cliente actualizado correctamente." : "Cliente creado correctamente.";
                await CargarClientes();
            }
            else
            {
                errorModal = await LeerMensaje(respuesta, "No se pudo guardar el cliente. Verifica los datos.");
            }
        }
        catch (Exception ex)
        {
            errorModal = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void PedirConfirmacionEliminar(ClienteModel cliente)
    {
        clienteAEliminar = cliente;
        mostrarConfirmacionEliminar = true;
    }

    private void CancelarEliminar()
    {
        clienteAEliminar = null;
        mostrarConfirmacionEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        if (clienteAEliminar is null) return;

        eliminando = true;
        mensajeOk = null;
        try
        {
            var respuesta = await Http.DeleteAsync($"Clientes/{clienteAEliminar.IdCliente}");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                mensajeOk = "Cliente eliminado correctamente.";
                await CargarClientes();
                if (paginaActual > TotalPaginas) paginaActual = TotalPaginas;
            }
            else
            {
                mensajeError = await LeerMensaje(respuesta, "No se pudo eliminar el cliente.");
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al eliminar: {ex.Message}";
        }
        finally
        {
            eliminando = false;
            mostrarConfirmacionEliminar = false;
            clienteAEliminar = null;
        }
    }

    // Lee el mensaje de error de la API: { mensaje: "..." } o errores de validación { errors: {...} }
    private static async Task<string> LeerMensaje(HttpResponseMessage respuesta, string porDefecto)
    {
        try
        {
            var contenido = await respuesta.Content.ReadAsStringAsync();
            using var documento = JsonDocument.Parse(contenido);
            var raiz = documento.RootElement;

            if (raiz.TryGetProperty("mensaje", out var mensaje) && mensaje.ValueKind == JsonValueKind.String)
                return mensaje.GetString()!;

            if (raiz.TryGetProperty("errors", out var errores) && errores.ValueKind == JsonValueKind.Object)
            {
                var lista = errores.EnumerateObject()
                    .SelectMany(e => e.Value.EnumerateArray())
                    .Select(v => v.GetString())
                    .Where(t => !string.IsNullOrWhiteSpace(t))
                    .ToList();

                if (lista.Any()) return string.Join(" ", lista);
            }
        }
        catch
        {
        }
        return porDefecto;
    }

    public class ClienteModel
    {
        public int IdCliente { get; set; }

        [Required(ErrorMessage = "Los nombres son obligatorios")]
        [StringLength(60, ErrorMessage = "Máximo 60 caracteres")]
        [RegularExpression(@"^[A-Za-zÁÉÍÓÚáéíóúÑñÜü ]+$", ErrorMessage = "Los nombres solo pueden contener letras")]
        public string Nombres { get; set; } = "";

        [Required(ErrorMessage = "Los apellidos son obligatorios")]
        [StringLength(60, ErrorMessage = "Máximo 60 caracteres")]
        [RegularExpression(@"^[A-Za-zÁÉÍÓÚáéíóúÑñÜü ]+$", ErrorMessage = "Los apellidos solo pueden contener letras")]
        public string Apellidos { get; set; } = "";

        [Required(ErrorMessage = "El NIT es obligatorio")]
        [StringLength(12, ErrorMessage = "Máximo 12 caracteres")]
        [RegularExpression(@"^([0-9]{1,10}-?[0-9Kk]|[Cc][Ff])$", ErrorMessage = "NIT inválido. Ejemplo: 1234567-8 o CF")]
        public string Nit { get; set; } = "";

        // Lo que se elige en el combo ("1" = Masculino, "0" = Femenino). No se envía a la API.
        [JsonIgnore]
        [Required(ErrorMessage = "Seleccione el género")]
        public string? GeneroSeleccion { get; set; }

        // Lo que se envía/recibe de la API (columna bit(1)).
        public ulong Genero
        {
            get => GeneroSeleccion == "1" ? 1UL : 0UL;
            set => GeneroSeleccion = value == 1 ? "1" : "0";
        }

        [RegularExpression(@"^([0-9]{8})?$", ErrorMessage = "El teléfono debe tener exactamente 8 dígitos")]
        public string? Telefono { get; set; }

        [StringLength(45, ErrorMessage = "Máximo 45 caracteres")]
        [RegularExpression(@"^([^@\s]+@[^@\s]+\.[^@\s]+)?$", ErrorMessage = "El correo electrónico no es válido")]
        public string? CorreoElectronico { get; set; }

        public DateTime FechaIngreso { get; set; }
    }
}
