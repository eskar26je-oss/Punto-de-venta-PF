@page "/reportes"

<PageTitle>Reportes</PageTitle>

<h3 class="mb-4">Reportes</h3>

<div class="row g-3">
    <div class="col-md-6">
        <a class="text-decoration-none" href="reportes/productos">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Reporte de productos</h5>
                    <p class="card-text text-muted">Producto, marca, existencia, precio de costo y precio de venta.</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6">
        <a class="text-decoration-none" href="reportes/existencias">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Reporte de existencias</h5>
                    <p class="card-text text-muted">Unidades compradas, vendidas y disponibles, con el estado de cada producto.</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6">
        <a class="text-decoration-none" href="reportes/compras">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Reporte de compras</h5>
                    <p class="card-text text-muted">Compras registradas con su proveedor y productos.</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6">
        <a class="text-decoration-none" href="reportes/ventas">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Reporte de ventas</h5>
                    <p class="card-text text-muted">Fecha, cliente, empleado y total de cada venta.</p>
                </div>
            </div>
        </a>
    </div>
</div>