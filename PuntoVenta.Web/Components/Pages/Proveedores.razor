@page "/proveedores"
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject SesionUsuario Sesion
@inject NavigationManager Nav

<PageTitle>Proveedores</PageTitle>

<h3 class="mb-3">Proveedores</h3>

@if (mensajeError is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (mensajeOk is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeOk
        <button type="button" class="btn-close" @onclick="() => mensajeOk = null"></button>
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input class="form-control" placeholder="Buscar por nombre, NIT, dirección o teléfono..."
               @bind="Buscar" @bind:event="oninput" />
    </div>
    <div class="col-md-6 text-md-end">
        <button class="btn btn-primary" @onclick="AbrirModalNuevo">Nuevo proveedor</button>
    </div>
</div>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 90px;">Código</th>
                    <th>Proveedor</th>
                    <th>NIT</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th class="text-center" style="width: 200px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!ProveedoresPagina.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No hay proveedores para mostrar</td>
                    </tr>
                }
                else
                {
                    @foreach (var proveedor in ProveedoresPagina)
                    {
                        <tr>
                            <td>@proveedor.IdProveedor</td>
                            <td>@proveedor.Proveedor</td>
                            <td>@proveedor.Nit</td>
                            <td>@proveedor.Direccion</td>
                            <td>@proveedor.Telefono</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-warning me-1" @onclick="() => AbrirModalEditar(proveedor)">Editar</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => PedirConfirmacionEliminar(proveedor)">Eliminar</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (TotalPaginas > 1)
    {
        <nav aria-label="Paginación de proveedores">
            <ul class="pagination justify-content-center">
                <li class="@ClaseItem(paginaActual == 1, false)">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual - 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= TotalPaginas; i++)
                {
                    var numeroPagina = i;
                    <li class="@ClaseItem(false, numeroPagina == paginaActual)">
                        <button class="page-link" @onclick="() => IrAPagina(numeroPagina)">@numeroPagina</button>
                    </li>
                }
                <li class="@ClaseItem(paginaActual == TotalPaginas, false)">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}
@if (mostrarModal)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <EditForm Model="proveedorActual" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />

                    <div class="modal-header">
                        <h5 class="modal-title">@(esEdicion ? "Editar proveedor" : "Nuevo proveedor")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body">
                        @if (errorModal is not null)
                        {
                            <div class="alert alert-danger">@errorModal</div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Proveedor</label>
                            <InputText class="form-control" @bind-Value="proveedorActual.Proveedor" />
                            <ValidationMessage For="() => proveedorActual.Proveedor" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">NIT</label>
                            <InputText class="form-control" placeholder="Ejemplo: 1234567-8" @bind-Value="proveedorActual.Nit" />
                            <ValidationMessage For="() => proveedorActual.Nit" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Dirección</label>
                            <InputText class="form-control" @bind-Value="proveedorActual.Direccion" />
                            <ValidationMessage For="() => proveedorActual.Direccion" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Teléfono</label>
                            <InputText class="form-control" maxlength="8" inputmode="numeric" placeholder="8 dígitos, ejemplo: 22221111" @bind-Value="proveedorActual.Telefono" />                            <ValidationMessage For="() => proveedorActual.Telefono" class="text-danger small" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (mostrarConfirmacionEliminar)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que deseas eliminar al proveedor <strong>@proveedorAEliminar?.Proveedor</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar" disabled="@eliminando">
                        @(eliminando ? "Eliminando..." : "Eliminar")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
@code {
    private List<ProveedorModel> proveedores = new();
    private ProveedorModel proveedorActual = new();
    private ProveedorModel? proveedorAEliminar;

    private bool mostrarModal;
    private bool mostrarConfirmacionEliminar;
    private bool esEdicion;
    private bool cargando = true;
    private bool guardando;
    private bool eliminando;

    private string? mensajeError;
    private string? mensajeOk;
    private string? errorModal;

    private string _buscar = "";
    private string Buscar
    {
        get => _buscar;
        set { _buscar = value; paginaActual = 1; }
    }

    private int paginaActual = 1;
    private const int tamanoPagina = 5;

    private IEnumerable<ProveedorModel> Filtrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Buscar)) return proveedores;

            var texto = Buscar.Trim();
            return proveedores.Where(p =>
                p.Proveedor.Contains(texto, StringComparison.OrdinalIgnoreCase)
                || p.Nit.Contains(texto, StringComparison.OrdinalIgnoreCase)
                || (p.Direccion ?? "").Contains(texto, StringComparison.OrdinalIgnoreCase)
                || (p.Telefono ?? "").Contains(texto, StringComparison.OrdinalIgnoreCase));
        }
    }

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(Filtrados.Count() / (double)tamanoPagina));

    private IEnumerable<ProveedorModel> ProveedoresPagina =>
        Filtrados.Skip((paginaActual - 1) * tamanoPagina).Take(tamanoPagina);

    protected override async Task OnInitializedAsync()
    {
        await CargarProveedores();
    }

    private async Task CargarProveedores()
    {
        cargando = true;
        try
        {
            var respuesta = await Http.GetAsync("Proveedores");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                proveedores = await respuesta.Content.ReadFromJsonAsync<List<ProveedorModel>>() ?? new();
            }
            else
            {
                mensajeError = "No se pudieron cargar los proveedores.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private bool SesionVencida(HttpResponseMessage respuesta)
    {
        if (respuesta.StatusCode != System.Net.HttpStatusCode.Unauthorized) return false;

        Sesion.Cerrar();
        Nav.NavigateTo("/login");
        return true;
    }

    private static string ClaseItem(bool desactivado, bool activo)
    {
        var clase = "page-item";
        if (desactivado) clase += " disabled";
        if (activo) clase += " active";
        return clase;
    }

    private void IrAPagina(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas) return;
        paginaActual = pagina;
    }

    private void AbrirModalNuevo()
    {
        proveedorActual = new ProveedorModel();
        esEdicion = false;
        errorModal = null;
        mostrarModal = true;
    }

    private void AbrirModalEditar(ProveedorModel proveedor)
    {
        proveedorActual = new ProveedorModel
        {
            IdProveedor = proveedor.IdProveedor,
            Proveedor = proveedor.Proveedor,
            Nit = proveedor.Nit,
            Direccion = proveedor.Direccion,
            Telefono = proveedor.Telefono
        };
        esEdicion = true;
        errorModal = null;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }
        private async Task Guardar()
    {
        guardando = true;
        errorModal = null;
        mensajeOk = null;
        try
        {
            HttpResponseMessage respuesta = esEdicion
                ? await Http.PutAsJsonAsync($"Proveedores/{proveedorActual.IdProveedor}", proveedorActual)
                : await Http.PostAsJsonAsync("Proveedores", proveedorActual);

            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                mostrarModal = false;
                mensajeOk = esEdicion ? "Proveedor actualizado correctamente." : "Proveedor creado correctamente.";
                await CargarProveedores();
            }
            else
            {
                errorModal = await LeerMensaje(respuesta, "No se pudo guardar el proveedor. Verifica los datos.");
            }
        }
        catch (Exception ex)
        {
            errorModal = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void PedirConfirmacionEliminar(ProveedorModel proveedor)
    {
        proveedorAEliminar = proveedor;
        mostrarConfirmacionEliminar = true;
    }

    private void CancelarEliminar()
    {
        proveedorAEliminar = null;
        mostrarConfirmacionEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        if (proveedorAEliminar is null) return;

        eliminando = true;
        mensajeOk = null;
        try
        {
            var respuesta = await Http.DeleteAsync($"Proveedores/{proveedorAEliminar.IdProveedor}");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                mensajeOk = "Proveedor eliminado correctamente.";
                await CargarProveedores();
                if (paginaActual > TotalPaginas) paginaActual = TotalPaginas;
            }
            else
            {
                mensajeError = await LeerMensaje(respuesta, "No se pudo eliminar el proveedor.");
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al eliminar: {ex.Message}";
        }
        finally
        {
            eliminando = false;
            mostrarConfirmacionEliminar = false;
            proveedorAEliminar = null;
        }
    }

    private static async Task<string> LeerMensaje(HttpResponseMessage respuesta, string porDefecto)
    {
        try
        {
            var error = await respuesta.Content.ReadFromJsonAsync<ErrorApi>();
            if (!string.IsNullOrWhiteSpace(error?.Mensaje)) return error.Mensaje!;
        }
        catch
        {
        }
        return porDefecto;
    }

    private record ErrorApi(string? Mensaje);

    public class ProveedorModel
    {
        public int IdProveedor { get; set; }

        [Required(ErrorMessage = "El nombre del proveedor es obligatorio")]
        [StringLength(60, ErrorMessage = "Máximo 60 caracteres")]
        public string Proveedor { get; set; } = "";

        [Required(ErrorMessage = "El NIT es obligatorio")]
        [StringLength(12, ErrorMessage = "Máximo 12 caracteres")]
        [RegularExpression(@"^[0-9]{1,10}-?[0-9Kk]$", ErrorMessage = "NIT inválido. Ejemplo: 1234567-8")]
        public string Nit { get; set; } = "";

        [StringLength(80, ErrorMessage = "Máximo 80 caracteres")]
        public string? Direccion { get; set; }

               [RegularExpression(@"^([0-9]{8})?$", ErrorMessage = "El teléfono debe tener exactamente 8 dígitos")]
        public string? Telefono { get; set; }
    }
}