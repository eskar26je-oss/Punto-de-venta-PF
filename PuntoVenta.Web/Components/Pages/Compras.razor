@page "/compras"
@inject HttpClient Http
@inject SesionUsuario Sesion
@inject NavigationManager Nav

<PageTitle>Compras</PageTitle>

<h3 class="mb-3">Compras</h3>

@if (mensajeError is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (mensajeOk is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeOk
        <button type="button" class="btn-close" @onclick="() => mensajeOk = null"></button>
    </div>
}

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (!modoFormulario)
{
    @* ===================== LISTA DE COMPRAS ===================== *@
    <div class="row g-2 mb-3">
        <div class="col-md-5">
            <input class="form-control" placeholder="Buscar por proveedor o no. de orden..."
                   @bind="Buscar" @bind:event="oninput" />
        </div>
        <div class="col-md-7 text-md-end">
            <button class="btn btn-primary" @onclick="NuevaCompra">Nueva compra</button>
            <a class="btn btn-outline-secondary" href="/reportes/compras">Reporte de compras</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>No. orden</th>
                    <th>Fecha</th>
                    <th>Proveedor</th>
                    <th class="text-end">Unidades</th>
                    <th class="text-end">Total</th>
                    <th class="text-center" style="width: 200px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!ComprasPagina.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">No hay compras para mostrar</td></tr>
                }
                else
                {
                    @foreach (var c in ComprasPagina)
                    {
                        <tr>
                            <td>@c.NoOrdenCompra</td>
                            <td>@c.FechaOrden.ToString("dd/MM/yyyy")</td>
                            <td>@c.Proveedor</td>
                            <td class="text-end">@c.Unidades</td>
                            <td class="text-end">@Q(c.Total)</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-warning me-1" @onclick="() => Editar(c.IdCompra)">Editar</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => PedirAnular(c)">Anular</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (TotalPaginas > 1)
    {
        <nav aria-label="Paginación de compras">
            <ul class="pagination justify-content-center">
                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual - 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= TotalPaginas; i++)
                {
                    var numeroPagina = i;
                    <li class="page-item @(numeroPagina == paginaActual ? "active" : "")">
                        <button class="page-link" @onclick="() => IrAPagina(numeroPagina)">@numeroPagina</button>
                    </li>
                }
                <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}
else
{
    @* ===================== FORMULARIO MAESTRO / DETALLE ===================== *@
    <div class="card mb-3">
        <div class="card-header">
            @(editandoId is null ? "Nueva compra" : $"Modificar compra No. {etiquetaEdicion}")
        </div>
        <div class="card-body">
            @if (errorForm is not null)
            {
                <div class="alert alert-danger">@errorForm</div>
            }

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Fecha de la orden</label>
                    <CampoFecha Value="fecha" ValueChanged="@((DateTime? v) => fecha = v ?? default)" />                </div>
                <div class="col-md-8">
                    <label class="form-label">Proveedor</label>
                    <select class="form-select" @bind="idProveedor">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var p in proveedores)
                        {
                            <option value="@p.Id">@p.Nombre (NIT: @p.Detalle)</option>
                        }
                    </select>
                </div>
            </div>

            <hr />
            <h6>Productos de la compra</h6>

            <div class="row g-2 align-items-end mb-1">
                <div class="col-md-5">
                    <label class="form-label">Producto</label>
                    <select class="form-select" @bind="IdProductoSel">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var p in productos)
                        {
                            <option value="@p.IdProducto">
                                @p.Producto (Existencia: @p.Existencia)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Cantidad</label>
                    <input type="number" min="1" class="form-control" @bind="cantidadSel" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Costo unitario (Q)</label>
                    <input type="number" min="0.01" step="0.01" class="form-control" @bind="precioSel" />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-success w-100" @onclick="AgregarLinea">Agregar</button>
                </div>
            </div>

            @if (ProductoSeleccionado is not null)
            {
                <div class="form-text mb-2">
                    Costo actual: @Q(ProductoSeleccionado.PrecioCosto) ·
                    Precio de venta: @Q(ProductoSeleccionado.PrecioVenta) ·
                    Existencia: @ProductoSeleccionado.Existencia
                </div>
                @if (precioSel >= ProductoSeleccionado.PrecioVenta)
                {
                    <div class="alert alert-warning py-2">
                        Ojo: el costo ingresado es igual o mayor al precio de venta (@Q(ProductoSeleccionado.PrecioVenta)).
                    </div>
                }
            }

            @if (errorLinea is not null)
            {
                <div class="alert alert-warning py-2">@errorLinea</div>
            }

            <div class="table-responsive mt-3">
                <table class="table table-sm table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th class="text-end">Costo unitario</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-end">Subtotal</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!lineas.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted">Aún no hay productos agregados</td></tr>
                        }
                        else
                        {
                            @foreach (var l in lineas)
                            {
                                <tr>
                                    <td>@l.Producto</td>
                                    <td class="text-end">@Q(l.PrecioCostoUnitario)</td>
                                    <td class="text-end">@l.Cantidad</td>
                                    <td class="text-end">@Q(l.Subtotal)</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Quitar(l)">Quitar</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total de la compra</th>
                            <th class="text-end">@Q(Total)</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="card-footer text-end">
            <button type="button" class="btn btn-secondary" @onclick="CancelarFormulario">Cancelar</button>
            <button type="button" class="btn btn-primary" @onclick="Guardar" disabled="@guardando">
                @(guardando ? "Guardando..." : "Guardar compra")
            </button>
        </div>
    </div>
}

@if (compraAAnular is not null)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Anular compra</h5>
                    <button type="button" class="btn-close" @onclick="CancelarAnular"></button>
                </div>
                <div class="modal-body">
                    <p>
                        ¿Seguro que deseas anular la compra No. <strong>@compraAAnular.NoOrdenCompra</strong>
                        de <strong>@compraAAnular.Proveedor</strong> por <strong>@Q(compraAAnular.Total)</strong>?
                    </p>
                    <p class="text-muted mb-0">
                        Se descontarán del inventario las unidades que ingresaron con esta compra.
                        Si ya se vendieron, no se podrá anular.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarAnular">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarAnular" disabled="@anulando">
                        @(anulando ? "Anulando..." : "Anular compra")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    // ----- Datos -----
    private List<CompraResumenModel> compras = new();
    private List<OpcionModel> proveedores = new();
    private List<ProductoModel> productos = new();

    // ----- Estado de pantalla -----
    private bool cargando = true;
    private bool modoFormulario;
    private bool guardando;
    private bool anulando;
    private string? mensajeError;
    private string? mensajeOk;
    private string? errorForm;
    private string? errorLinea;

    // ----- Lista: búsqueda y paginación -----
    private string _buscar = "";
    private string Buscar
    {
        get => _buscar;
        set { _buscar = value; paginaActual = 1; }
    }
    private int paginaActual = 1;
    private const int tamanoPagina = 8;

    private IEnumerable<CompraResumenModel> Filtradas =>
        string.IsNullOrWhiteSpace(Buscar)
            ? compras
            : compras.Where(c =>
                c.Proveedor.Contains(Buscar.Trim(), StringComparison.OrdinalIgnoreCase) ||
                c.NoOrdenCompra.ToString().Contains(Buscar.Trim()));

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(Filtradas.Count() / (double)tamanoPagina));

    private IEnumerable<CompraResumenModel> ComprasPagina =>
        Filtradas.Skip((paginaActual - 1) * tamanoPagina).Take(tamanoPagina);

    // ----- Formulario -----
    private int? editandoId;
    private string etiquetaEdicion = "";
    private DateTime fecha = DateTime.Today;
    private int idProveedor;
    private int cantidadSel = 1;
    private decimal precioSel;
    private List<LineaCompra> lineas = new();

    // Al elegir un producto se sugiere su costo actual en "Costo unitario".
    private int _idProductoSel;
    private int IdProductoSel
    {
        get => _idProductoSel;
        set
        {
            _idProductoSel = value;
            precioSel = productos.FirstOrDefault(p => p.IdProducto == value)?.PrecioCosto ?? 0;
        }
    }

    private CompraResumenModel? compraAAnular;

    private ProductoModel? ProductoSeleccionado =>
        productos.FirstOrDefault(p => p.IdProducto == IdProductoSel);

    private decimal Total => lineas.Sum(l => l.Subtotal);

    private static string Q(decimal valor) =>
        "Q" + valor.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        await CargarTodo();
    }

    private async Task CargarTodo()
    {
        cargando = true;
        try
        {
            compras = await Obtener<List<CompraResumenModel>>("Compras") ?? new();
            proveedores = await Obtener<List<OpcionModel>>("Compras/proveedores") ?? new();
            productos = await Obtener<List<ProductoModel>>("Compras/productos") ?? new();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task<T?> Obtener<T>(string ruta) where T : class
    {
        var respuesta = await Http.GetAsync(ruta);
        if (SesionVencida(respuesta)) return null;

        if (!respuesta.IsSuccessStatusCode)
        {
            mensajeError = $"No se pudo cargar la información ({ruta}).";
            return null;
        }
        return await respuesta.Content.ReadFromJsonAsync<T>();
    }

    private bool SesionVencida(HttpResponseMessage respuesta)
    {
        if (respuesta.StatusCode != System.Net.HttpStatusCode.Unauthorized) return false;

        Sesion.Cerrar();
        Nav.NavigateTo("/login");
        return true;
    }

    private void IrAPagina(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas) return;
        paginaActual = pagina;
    }

    // ===================== Nueva / editar =====================

    private void NuevaCompra()
    {
        LimpiarFormulario();
        modoFormulario = true;
    }

    private async Task Editar(int id)
    {
        mensajeOk = null;
        var compra = await Obtener<CompraModel>($"Compras/{id}");
        if (compra is null) return;

        LimpiarFormulario();
        editandoId = compra.IdCompra;
        etiquetaEdicion = compra.NoOrdenCompra.ToString();
        fecha = compra.FechaOrden.ToDateTime(TimeOnly.MinValue);
        idProveedor = compra.IdProveedor;

        // En la compra se respeta el costo con el que se registró cada línea.
        lineas = compra.Detalles.Select(d => new LineaCompra
        {
            IdProducto = d.IdProducto,
            Producto = d.Producto,
            Cantidad = d.Cantidad,
            PrecioCostoUnitario = d.PrecioCostoUnitario
        }).ToList();

        modoFormulario = true;
    }

    private void LimpiarFormulario()
    {
        editandoId = null;
        etiquetaEdicion = "";
        fecha = DateTime.Today;
        idProveedor = 0;
        IdProductoSel = 0;
        cantidadSel = 1;
        precioSel = 0;
        lineas = new();
        errorForm = null;
        errorLinea = null;
    }

    private void CancelarFormulario()
    {
        modoFormulario = false;
    }

    // ===================== Detalle =====================

    private void AgregarLinea()
    {
        errorLinea = null;

        if (IdProductoSel == 0)
        {
            errorLinea = "Seleccione un producto.";
            return;
        }
        if (cantidadSel <= 0)
        {
            errorLinea = "La cantidad debe ser mayor a cero.";
            return;
        }
        if (precioSel <= 0)
        {
            errorLinea = "El costo unitario debe ser mayor a cero.";
            return;
        }

        var producto = productos.First(p => p.IdProducto == IdProductoSel);
        var existente = lineas.FirstOrDefault(l => l.IdProducto == producto.IdProducto);

        if (existente is not null)
        {
            // Mismo producto: se suma la cantidad y se usa el último costo ingresado.
            existente.Cantidad += cantidadSel;
            existente.PrecioCostoUnitario = Math.Round(precioSel, 2);
        }
        else
        {
            lineas.Add(new LineaCompra
            {
                IdProducto = producto.IdProducto,
                Producto = producto.Producto,
                Cantidad = cantidadSel,
                PrecioCostoUnitario = Math.Round(precioSel, 2)
            });
        }

        IdProductoSel = 0;
        cantidadSel = 1;
    }

    private void Quitar(LineaCompra linea)
    {
        lineas.Remove(linea);
        errorLinea = null;
    }

    // ===================== Guardar =====================

    private async Task Guardar()
    {
        errorForm = null;

        if (fecha == default)
        {
            errorForm = "La fecha de la orden es obligatoria.";
            return;
        }
        if (fecha.Date > DateTime.Today)
        {
            errorForm = "La fecha de la orden no puede ser futura.";
            return;
        }
        if (idProveedor == 0)
        {
            errorForm = "Seleccione un proveedor.";
            return;
        }
        if (!lineas.Any())
        {
            errorForm = "Agregue al menos un producto a la compra.";
            return;
        }

        guardando = true;
        try
        {
            var cuerpo = new
            {
                fechaOrden = DateOnly.FromDateTime(fecha),
                idProveedor,
                detalles = lineas.Select(l => new
                {
                    idProducto = l.IdProducto,
                    cantidad = l.Cantidad,
                    precioCostoUnitario = l.PrecioCostoUnitario
                }).ToList()
            };

            var respuesta = editandoId is null
                ? await Http.PostAsJsonAsync("Compras", cuerpo)
                : await Http.PutAsJsonAsync($"Compras/{editandoId}", cuerpo);

            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                if (editandoId is null)
                {
                    var creada = await respuesta.Content.ReadFromJsonAsync<CompraModel>();
                    mensajeOk = creada is null
                        ? "Compra registrada correctamente."
                        : $"Compra No. {creada.NoOrdenCompra} registrada. Total: {Q(creada.Total)}. La existencia se actualizó.";
                }
                else
                {
                    mensajeOk = "Compra actualizada correctamente.";
                }

                modoFormulario = false;
                await CargarTodo();
            }
            else
            {
                errorForm = await LeerMensaje(respuesta, "No se pudo guardar la compra. Verifique los datos.");
                // Refrescar productos para mostrar la existencia real.
                productos = await Obtener<List<ProductoModel>>("Compras/productos") ?? productos;
            }
        }
        catch (Exception ex)
        {
            errorForm = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    // ===================== Anular =====================

    private void PedirAnular(CompraResumenModel compra) => compraAAnular = compra;

    private void CancelarAnular() => compraAAnular = null;

    private async Task ConfirmarAnular()
    {
        if (compraAAnular is null) return;

        anulando = true;
        mensajeOk = null;
        try
        {
            var respuesta = await Http.DeleteAsync($"Compras/{compraAAnular.IdCompra}");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                mensajeOk = "Compra anulada. Las unidades se descontaron del inventario.";
                await CargarTodo();
                if (paginaActual > TotalPaginas) paginaActual = TotalPaginas;
            }
            else
            {
                mensajeError = await LeerMensaje(respuesta, "No se pudo anular la compra.");
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al anular: {ex.Message}";
        }
        finally
        {
            anulando = false;
            compraAAnular = null;
        }
    }

    private static async Task<string> LeerMensaje(HttpResponseMessage respuesta, string porDefecto)
    {
        try
        {
            var error = await respuesta.Content.ReadFromJsonAsync<ErrorApi>();
            if (!string.IsNullOrWhiteSpace(error?.Mensaje)) return error.Mensaje!;
        }
        catch
        {
        }
        return porDefecto;
    }

    private record ErrorApi(string? Mensaje);

    // ===================== Modelos =====================

    public class OpcionModel
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string? Detalle { get; set; }
    }

    public class ProductoModel
    {
        public int IdProducto { get; set; }
        public string Producto { get; set; } = "";
        public decimal PrecioCosto { get; set; }
        public decimal PrecioVenta { get; set; }
        public int Existencia { get; set; }
    }

    public class CompraResumenModel
    {
        public int IdCompra { get; set; }
        public int NoOrdenCompra { get; set; }
        public DateOnly FechaOrden { get; set; }
        public string Proveedor { get; set; } = "";
        public int Unidades { get; set; }
        public decimal Total { get; set; }
    }

    public class CompraModel
    {
        public int IdCompra { get; set; }
        public int NoOrdenCompra { get; set; }
        public DateOnly FechaOrden { get; set; }
        public int IdProveedor { get; set; }
        public string Proveedor { get; set; } = "";
        public decimal Total { get; set; }
        public List<CompraDetalleModel> Detalles { get; set; } = new();
    }

    public class CompraDetalleModel
    {
        public int IdProducto { get; set; }
        public string Producto { get; set; } = "";
        public int Cantidad { get; set; }
        public decimal PrecioCostoUnitario { get; set; }
        public decimal Subtotal { get; set; }
    }

    public class LineaCompra
    {
        public int IdProducto { get; set; }
        public string Producto { get; set; } = "";
        public int Cantidad { get; set; }
        public decimal PrecioCostoUnitario { get; set; }
        public decimal Subtotal => Cantidad * PrecioCostoUnitario;
    }
}
