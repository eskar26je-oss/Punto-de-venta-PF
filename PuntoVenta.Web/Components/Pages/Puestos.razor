@page "/puestos"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@inject HttpClient Http
@inject SesionUsuario Sesion
@inject NavigationManager Nav

<PageTitle>Puestos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Puestos</h3>
    <a class="btn btn-outline-secondary btn-sm" href="empleados">&larr; Regresar a Empleados</a>
</div>

@if (mensajeError is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (mensajeOk is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeOk
        <button type="button" class="btn-close" @onclick="() => mensajeOk = null"></button>
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input class="form-control" placeholder="Buscar puesto..."
               @bind="Buscar" @bind:event="oninput" />
    </div>
    <div class="col-md-6 text-md-end">
        <button class="btn btn-primary" @onclick="AbrirModalNuevo">Nuevo puesto</button>
    </div>
</div>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 100px;">Código</th>
                    <th>Puesto</th>
                    <th class="text-center" style="width: 200px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!PuestosPagina.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">No hay puestos para mostrar</td>
                    </tr>
                }
                else
                {
                    @foreach (var puesto in PuestosPagina)
                    {
                        <tr>
                            <td>@puesto.IdPuesto</td>
                            <td>@puesto.Nombre</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-warning me-1" @onclick="() => AbrirModalEditar(puesto)">Editar</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => PedirConfirmacionEliminar(puesto)">Eliminar</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (TotalPaginas > 1)
    {
        <nav aria-label="Paginación de puestos">
            <ul class="pagination justify-content-center">
                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual - 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= TotalPaginas; i++)
                {
                    var numeroPagina = i;
                    <li class="page-item @(numeroPagina == paginaActual ? "active" : "")">
                        <button class="page-link" @onclick="() => IrAPagina(numeroPagina)">@numeroPagina</button>
                    </li>
                }
                <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}

@if (mostrarModal)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <EditForm Model="puestoActual" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />

                    <div class="modal-header">
                        <h5 class="modal-title">@(esEdicion ? "Editar puesto" : "Nuevo puesto")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body">
                        @if (errorModal is not null)
                        {
                            <div class="alert alert-danger">@errorModal</div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Puesto</label>
                            <InputText class="form-control" @bind-Value="puestoActual.Nombre" />
                            <ValidationMessage For="() => puestoActual.Nombre" class="text-danger small" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (mostrarConfirmacionEliminar)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que deseas eliminar el puesto <strong>@puestoAEliminar?.Nombre</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar" disabled="@eliminando">
                        @(eliminando ? "Eliminando..." : "Eliminar")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<PuestoModel> puestos = new();
    private PuestoModel puestoActual = new();
    private PuestoModel? puestoAEliminar;

    private bool mostrarModal;
    private bool mostrarConfirmacionEliminar;
    private bool esEdicion;
    private bool cargando = true;
    private bool guardando;
    private bool eliminando;

    private string? mensajeError;
    private string? mensajeOk;
    private string? errorModal;

    private string _buscar = "";
    private string Buscar
    {
        get => _buscar;
        set { _buscar = value; paginaActual = 1; }
    }

    private int paginaActual = 1;
    private const int tamanoPagina = 5;

    private IEnumerable<PuestoModel> Filtradas =>
        string.IsNullOrWhiteSpace(Buscar)
            ? puestos
            : puestos.Where(p => p.Nombre.Contains(Buscar.Trim(), StringComparison.OrdinalIgnoreCase));

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(Filtradas.Count() / (double)tamanoPagina));

    private IEnumerable<PuestoModel> PuestosPagina =>
        Filtradas.Skip((paginaActual - 1) * tamanoPagina).Take(tamanoPagina);

    protected override async Task OnInitializedAsync()
    {
        await CargarPuestos();
    }

    private async Task CargarPuestos()
    {
        cargando = true;
        try
        {
            var respuesta = await Http.GetAsync("Puestos");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                puestos = await respuesta.Content.ReadFromJsonAsync<List<PuestoModel>>() ?? new();
            }
            else
            {
                mensajeError = "No se pudieron cargar los puestos.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private bool SesionVencida(HttpResponseMessage respuesta)
    {
        if (respuesta.StatusCode != System.Net.HttpStatusCode.Unauthorized) return false;

        Sesion.Cerrar();
        Nav.NavigateTo("/login");
        return true;
    }

    private void IrAPagina(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas) return;
        paginaActual = pagina;
    }

    private void AbrirModalNuevo()
    {
        puestoActual = new PuestoModel();
        esEdicion = false;
        errorModal = null;
        mostrarModal = true;
    }

    private void AbrirModalEditar(PuestoModel puesto)
    {
        puestoActual = new PuestoModel { IdPuesto = puesto.IdPuesto, Nombre = puesto.Nombre };
        esEdicion = true;
        errorModal = null;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task Guardar()
    {
        guardando = true;
        errorModal = null;
        mensajeOk = null;
        try
        {
            HttpResponseMessage respuesta = esEdicion
                ? await Http.PutAsJsonAsync($"Puestos/{puestoActual.IdPuesto}", puestoActual)
                : await Http.PostAsJsonAsync("Puestos", puestoActual);

            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                mostrarModal = false;
                mensajeOk = esEdicion ? "Puesto actualizado correctamente." : "Puesto creado correctamente.";
                await CargarPuestos();
            }
            else
            {
                errorModal = await LeerMensaje(respuesta, "No se pudo guardar el puesto. Verifica los datos.");
            }
        }
        catch (Exception ex)
        {
            errorModal = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void PedirConfirmacionEliminar(PuestoModel puesto)
    {
        puestoAEliminar = puesto;
        mostrarConfirmacionEliminar = true;
    }

    private void CancelarEliminar()
    {
        puestoAEliminar = null;
        mostrarConfirmacionEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        if (puestoAEliminar is null) return;

        eliminando = true;
        mensajeOk = null;
        try
        {
            var respuesta = await Http.DeleteAsync($"Puestos/{puestoAEliminar.IdPuesto}");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                mensajeOk = "Puesto eliminado correctamente.";
                await CargarPuestos();
                if (paginaActual > TotalPaginas) paginaActual = TotalPaginas;
            }
            else
            {
                mensajeError = await LeerMensaje(respuesta, "No se pudo eliminar el puesto.");
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al eliminar: {ex.Message}";
        }
        finally
        {
            eliminando = false;
            mostrarConfirmacionEliminar = false;
            puestoAEliminar = null;
        }
    }

    // Lee el mensaje de error de la API: { mensaje: "..." } o errores de validación { errors: {...} }
    private static async Task<string> LeerMensaje(HttpResponseMessage respuesta, string porDefecto)
    {
        try
        {
            var contenido = await respuesta.Content.ReadAsStringAsync();
            using var documento = JsonDocument.Parse(contenido);
            var raiz = documento.RootElement;

            if (raiz.TryGetProperty("mensaje", out var mensaje) && mensaje.ValueKind == JsonValueKind.String)
                return mensaje.GetString()!;

            if (raiz.TryGetProperty("errors", out var errores) && errores.ValueKind == JsonValueKind.Object)
            {
                var lista = errores.EnumerateObject()
                    .SelectMany(e => e.Value.EnumerateArray())
                    .Select(v => v.GetString())
                    .Where(t => !string.IsNullOrWhiteSpace(t))
                    .ToList();

                if (lista.Any()) return string.Join(" ", lista);
            }
        }
        catch
        {
        }
        return porDefecto;
    }

    public class PuestoModel
    {
        public short IdPuesto { get; set; }

        [Required(ErrorMessage = "El nombre del puesto es obligatorio")]
        [StringLength(50, ErrorMessage = "Máximo 50 caracteres")]
        public string Nombre { get; set; } = "";
    }
}
