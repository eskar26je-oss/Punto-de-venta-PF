@page "/reportes/ventas"
@inject HttpClient Http
@inject SesionUsuario Sesion
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Reporte de ventas</PageTitle>

<h3 class="mb-3">Reporte de ventas</h3>

@if (mensajeError is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

<div class="card mb-3 d-print-none">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Desde</label>
                <input type="date" class="form-control" @bind="desde" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" @bind="hasta" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Cliente</label>
                <select class="form-select" @bind="idCliente">
                    <option value="0">Todos</option>
                    @foreach (var c in clientes)
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Empleado</label>
                <select class="form-select" @bind="idEmpleado">
                    <option value="0">Todos</option>
                    @foreach (var e in empleados)
                    {
                        <option value="@e.Id">@e.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-primary" @onclick="Consultar" disabled="@cargando">
                @(cargando ? "Consultando..." : "Consultar")
            </button>
            <button class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar filtros</button>
            <button class="btn btn-outline-dark" @onclick="Imprimir" disabled="@(reporte is null)">Imprimir</button>
            <a class="btn btn-link" href="/ventas">Ir a Ventas</a>
        </div>
    </div>
</div>

@if (reporte is not null)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Factura</th>
                    <th>Cliente</th>
                    <th>Empleado</th>
                    <th class="text-end">Total Venta</th>
                </tr>
            </thead>
            <tbody>
                @if (!reporte.Ventas.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">No hay ventas en el rango seleccionado</td></tr>
                }
                else
                {
                    @foreach (var v in reporte.Ventas)
                    {
                        <tr>
                            <td>@v.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@v.Serie-@v.NoFactura</td>
                            <td>@v.Cliente</td>
                            <td>@v.Empleado</td>
                            <td class="text-end">@Q(v.TotalVenta)</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4" class="text-end">Total general (@reporte.CantidadVentas ventas)</th>
                    <th class="text-end">@Q(reporte.TotalGeneral)</th>
                </tr>
            </tfoot>
        </table>
    </div>
}
else if (cargando)
{
    <p><em>Cargando...</em></p>
}

@code {
    private ReporteModel? reporte;
    private List<OpcionModel> clientes = new();
    private List<OpcionModel> empleados = new();

    private DateTime? desde;
    private DateTime? hasta;
    private int idCliente;
    private int idEmpleado;

    private bool cargando = true;
    private string? mensajeError;

    private static string Q(decimal valor) =>
        "Q" + valor.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes = await Obtener<List<OpcionModel>>("Ventas/clientes") ?? new();
            empleados = await Obtener<List<OpcionModel>>("Ventas/empleados") ?? new();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }

        await Consultar();
    }

    private async Task Consultar()
    {
        mensajeError = null;

        if (desde.HasValue && hasta.HasValue && desde.Value.Date > hasta.Value.Date)
        {
            mensajeError = "La fecha inicial no puede ser mayor que la fecha final.";
            return;
        }

        var filtros = new List<string>();
        if (desde.HasValue) filtros.Add($"desde={desde.Value:yyyy-MM-dd}");
        if (hasta.HasValue) filtros.Add($"hasta={hasta.Value:yyyy-MM-dd}");
        if (idCliente > 0) filtros.Add($"idCliente={idCliente}");
        if (idEmpleado > 0) filtros.Add($"idEmpleado={idEmpleado}");

        var ruta = "reportes/ventas" + (filtros.Count > 0 ? "?" + string.Join("&", filtros) : "");

        cargando = true;
        try
        {
            reporte = await Obtener<ReporteModel>(ruta);
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Limpiar()
    {
        desde = null;
        hasta = null;
        idCliente = 0;
        idEmpleado = 0;
        await Consultar();
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("print");
    }

    private async Task<T?> Obtener<T>(string ruta) where T : class
    {
        var respuesta = await Http.GetAsync(ruta);

        if (respuesta.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Sesion.Cerrar();
            Nav.NavigateTo("/login");
            return null;
        }

        if (!respuesta.IsSuccessStatusCode)
        {
            try
            {
                var error = await respuesta.Content.ReadFromJsonAsync<ErrorApi>();
                mensajeError = error?.Mensaje ?? "No se pudo cargar el reporte.";
            }
            catch
            {
                mensajeError = "No se pudo cargar el reporte.";
            }
            return null;
        }

        return await respuesta.Content.ReadFromJsonAsync<T>();
    }

    private record ErrorApi(string? Mensaje);

    public class OpcionModel
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
    }

    public class ReporteModel
    {
        public int CantidadVentas { get; set; }
        public decimal TotalGeneral { get; set; }
        public List<FilaModel> Ventas { get; set; } = new();
    }

    public class FilaModel
    {
        public DateOnly Fecha { get; set; }
        public string Serie { get; set; } = "";
        public int NoFactura { get; set; }
        public string Cliente { get; set; } = "";
        public string Empleado { get; set; } = "";
        public decimal TotalVenta { get; set; }
    }
}
