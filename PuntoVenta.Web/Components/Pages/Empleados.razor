@page "/empleados"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject SesionUsuario Sesion
@inject NavigationManager Nav

<PageTitle>Empleados</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Empleados</h3>
    <a class="btn btn-outline-secondary btn-sm" href="puestos">Ir a Puestos</a>
</div>

@if (mensajeError is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (mensajeOk is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeOk
        <button type="button" class="btn-close" @onclick="() => mensajeOk = null"></button>
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-md-5">
        <input class="form-control" placeholder="Buscar por nombre, DPI o teléfono..."
               @bind="Buscar" @bind:event="oninput" />
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="FiltroPuesto">
            <option value="0">Todos los puestos</option>
            @foreach (var puesto in puestos)
            {
                <option value="@puesto.IdPuesto">@puesto.Nombre</option>
            }
        </select>
    </div>
    <div class="col-md-4 text-md-end">
        <button class="btn btn-primary" @onclick="AbrirModalNuevo">Nuevo empleado</button>
    </div>
</div>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>DPI</th>
                    <th>Teléfono</th>
                    <th>Puesto</th>
                    <th>Género</th>
                    <th>Inicio labores</th>
                    <th class="text-center" style="width: 170px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!EmpleadosPagina.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">No hay empleados para mostrar</td>
                    </tr>
                }
                else
                {
                    @foreach (var empleado in EmpleadosPagina)
                    {
                        <tr>
                            <td>@empleado.IdEmpleado</td>
                            <td>@empleado.Nombres @empleado.Apellidos</td>
                            <td>@empleado.Dpi</td>
                            <td>@(empleado.Telefono ?? "-")</td>
                            <td>@NombrePuesto(empleado.IdPuesto)</td>
                            <td>@(empleado.Genero == 1 ? "Masculino" : "Femenino")</td>
                            <td>@(empleado.FechaInicioLabores?.ToString("dd/MM/yyyy"))</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-warning me-1" @onclick="() => autorizacion.Ejecutar(Recurso, empleado.IdEmpleado, () => AbrirModalEditar(empleado))">Editar</button>
<button class="btn btn-sm btn-danger" @onclick="() => autorizacion.Ejecutar(Recurso, empleado.IdEmpleado, () => PedirConfirmacionEliminar(empleado))">Eliminar</button>                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (TotalPaginas > 1)
    {
        <nav aria-label="Paginación de empleados">
            <ul class="pagination justify-content-center">
                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual - 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= TotalPaginas; i++)
                {
                    var numeroPagina = i;
                    <li class="page-item @(numeroPagina == paginaActual ? "active" : "")">
                        <button class="page-link" @onclick="() => IrAPagina(numeroPagina)">@numeroPagina</button>
                    </li>
                }
                <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}

@if (mostrarModal)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <EditForm Model="empleadoActual" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />

                    <div class="modal-header">
                        <h5 class="modal-title">@(esEdicion ? "Editar empleado" : "Nuevo empleado")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body">
                        @if (errorModal is not null)
                        {
                            <div class="alert alert-danger">@errorModal</div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombres</label>
                                <InputText class="form-control" maxlength="60" @bind-Value="empleadoActual.Nombres" />
                                <ValidationMessage For="() => empleadoActual.Nombres" class="text-danger small" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Apellidos</label>
                                <InputText class="form-control" maxlength="60" @bind-Value="empleadoActual.Apellidos" />
                                <ValidationMessage For="() => empleadoActual.Apellidos" class="text-danger small" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">DPI</label>
                                <InputText class="form-control" maxlength="13" placeholder="13 dígitos"
                                           @bind-Value="empleadoActual.Dpi" />
                                <ValidationMessage For="() => empleadoActual.Dpi" class="text-danger small" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" maxlength="8" placeholder="8 dígitos (opcional)"
                                           @bind-Value="empleadoActual.Telefono" />
                                <ValidationMessage For="() => empleadoActual.Telefono" class="text-danger small" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Dirección</label>
                            <InputText class="form-control" maxlength="80" placeholder="Opcional"
                                       @bind-Value="empleadoActual.Direccion" />
                            <ValidationMessage For="() => empleadoActual.Direccion" class="text-danger small" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Género</label>
                                <InputSelect class="form-select" @bind-Value="empleadoActual.GeneroSeleccion">
                                    <option value="">-- Seleccione --</option>
                                    <option value="1">Masculino</option>
                                    <option value="0">Femenino</option>
                                </InputSelect>
                                <ValidationMessage For="() => empleadoActual.GeneroSeleccion" class="text-danger small" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="d-flex justify-content-between">
                                    <label class="form-label">Puesto</label>
                                    <a href="puestos" class="small">Administrar puestos</a>
                                </div>
                                <InputSelect class="form-select" @bind-Value="empleadoActual.IdPuesto">
                                    <option value="0">-- Seleccione un puesto --</option>
                                    @foreach (var puesto in puestos)
                                    {
                                        <option value="@puesto.IdPuesto">@puesto.Nombre</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => empleadoActual.IdPuesto" class="text-danger small" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha de nacimiento</label>
                                <CampoFecha Value="@(empleadoActual.FechaNacimiento?.ToDateTime(TimeOnly.MinValue))"
            ValueChanged="@((DateTime? v) => empleadoActual.FechaNacimiento = v is null ? null : DateOnly.FromDateTime(v.Value))" />
                                <ValidationMessage For="() => empleadoActual.FechaNacimiento" class="text-danger small" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha de inicio de labores</label>
                                <CampoFecha Value="@(empleadoActual.FechaInicioLabores?.ToDateTime(TimeOnly.MinValue))"
            ValueChanged="@((DateTime? v) => empleadoActual.FechaInicioLabores = v is null ? null : DateOnly.FromDateTime(v.Value))" />
                                <ValidationMessage For="() => empleadoActual.FechaInicioLabores" class="text-danger small" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (mostrarConfirmacionEliminar)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que deseas eliminar al empleado <strong>@(empleadoAEliminar?.Nombres) @(empleadoAEliminar?.Apellidos)</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar" disabled="@eliminando">
                        @(eliminando ? "Eliminando..." : "Eliminar")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
<AutorizacionAdmin @ref="autorizacion" />
@code {
    private AutorizacionAdmin autorizacion = default!;
private const string Recurso = "empleados";
    private List<EmpleadoModel> empleados = new();
    private List<PuestoModel> puestos = new();
    private EmpleadoModel empleadoActual = new();
    private EmpleadoModel? empleadoAEliminar;

    private bool mostrarModal;
    private bool mostrarConfirmacionEliminar;
    private bool esEdicion;
    private bool cargando = true;
    private bool guardando;
    private bool eliminando;

    private string? mensajeError;
    private string? mensajeOk;
    private string? errorModal;

    private string _buscar = "";
    private string Buscar
    {
        get => _buscar;
        set { _buscar = value; paginaActual = 1; }
    }

    private int _filtroPuesto;
    private int FiltroPuesto
    {
        get => _filtroPuesto;
        set { _filtroPuesto = value; paginaActual = 1; }
    }

    private int paginaActual = 1;
    private const int tamanoPagina = 5;

    private IEnumerable<EmpleadoModel> Filtrados
    {
        get
        {
            IEnumerable<EmpleadoModel> lista = empleados;

            if (FiltroPuesto > 0)
                lista = lista.Where(e => e.IdPuesto == FiltroPuesto);

            if (string.IsNullOrWhiteSpace(Buscar)) return lista;

            var texto = Buscar.Trim();
            return lista.Where(e =>
                e.IdEmpleado.ToString() == texto
                || $"{e.Nombres} {e.Apellidos}".Contains(texto, StringComparison.OrdinalIgnoreCase)
                || e.Dpi.Contains(texto)
                || (e.Telefono ?? "").Contains(texto));
        }
    }

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(Filtrados.Count() / (double)tamanoPagina));

    private IEnumerable<EmpleadoModel> EmpleadosPagina =>
        Filtrados.Skip((paginaActual - 1) * tamanoPagina).Take(tamanoPagina);

    private string NombrePuesto(short idPuesto)
    {
        return puestos.FirstOrDefault(p => p.IdPuesto == idPuesto)?.Nombre ?? "-";
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarPuestos();
        await CargarEmpleados();
    }

    private async Task CargarPuestos()
    {
        try
        {
            var respuesta = await Http.GetAsync("Puestos");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                puestos = await respuesta.Content.ReadFromJsonAsync<List<PuestoModel>>() ?? new();
                puestos = puestos.OrderBy(p => p.Nombre).ToList();
            }
            else
            {
                mensajeError = "No se pudieron cargar los puestos.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }
    }

    private async Task CargarEmpleados()
    {
        cargando = true;
        try
        {
            var respuesta = await Http.GetAsync("Empleados");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                empleados = await respuesta.Content.ReadFromJsonAsync<List<EmpleadoModel>>() ?? new();
            }
            else
            {
                mensajeError = "No se pudieron cargar los empleados.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private bool SesionVencida(HttpResponseMessage respuesta)
    {
        if (respuesta.StatusCode != System.Net.HttpStatusCode.Unauthorized) return false;

        Sesion.Cerrar();
        Nav.NavigateTo("/login");
        return true;
    }

    private void IrAPagina(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas) return;
        paginaActual = pagina;
    }

    private void AbrirModalNuevo()
    {
        empleadoActual = new EmpleadoModel();
        esEdicion = false;
        errorModal = null;
        mostrarModal = true;
    }

    private void AbrirModalEditar(EmpleadoModel empleado)
    {
        empleadoActual = new EmpleadoModel
        {
            IdEmpleado = empleado.IdEmpleado,
            Nombres = empleado.Nombres,
            Apellidos = empleado.Apellidos,
            Direccion = empleado.Direccion,
            Telefono = empleado.Telefono,
            Dpi = empleado.Dpi,
            Genero = empleado.Genero,
            FechaNacimiento = empleado.FechaNacimiento,
            IdPuesto = empleado.IdPuesto,
            FechaInicioLabores = empleado.FechaInicioLabores,
            FechaIngreso = empleado.FechaIngreso
        };
        esEdicion = true;
        errorModal = null;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task Guardar()
    {
        guardando = true;
        errorModal = null;
        mensajeOk = null;
        try
        {
            HttpResponseMessage respuesta = esEdicion
                ? await Http.PutAsJsonAsync($"Empleados/{empleadoActual.IdEmpleado}", empleadoActual)
                : await Http.PostAsJsonAsync("Empleados", empleadoActual);

            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                mostrarModal = false;
                mensajeOk = esEdicion ? "Empleado actualizado correctamente." : "Empleado creado correctamente.";
                await CargarEmpleados();
            }
            else
            {
                errorModal = await LeerMensaje(respuesta, "No se pudo guardar el empleado. Verifica los datos.");
            }
        }
        catch (Exception ex)
        {
            errorModal = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void PedirConfirmacionEliminar(EmpleadoModel empleado)
    {
        empleadoAEliminar = empleado;
        mostrarConfirmacionEliminar = true;
    }

    private void CancelarEliminar()
    {
        empleadoAEliminar = null;
        mostrarConfirmacionEliminar = false;
    }

    private async Task ConfirmarEliminar()
    {
        if (empleadoAEliminar is null) return;

        eliminando = true;
        mensajeOk = null;
        try
        {
            var respuesta = await Http.DeleteAsync($"Empleados/{empleadoAEliminar.IdEmpleado}");
            if (SesionVencida(respuesta)) return;

            if (respuesta.IsSuccessStatusCode)
            {
                mensajeOk = "Empleado eliminado correctamente.";
                await CargarEmpleados();
                if (paginaActual > TotalPaginas) paginaActual = TotalPaginas;
            }
            else
            {
                mensajeError = await LeerMensaje(respuesta, "No se pudo eliminar el empleado.");
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al eliminar: {ex.Message}";
        }
        finally
        {
            eliminando = false;
            mostrarConfirmacionEliminar = false;
            empleadoAEliminar = null;
        }
    }

    // Lee el mensaje de error de la API: { mensaje: "..." } o errores de validación { errors: {...} }
    private static async Task<string> LeerMensaje(HttpResponseMessage respuesta, string porDefecto)
    {
        try
        {
            var contenido = await respuesta.Content.ReadAsStringAsync();
            using var documento = JsonDocument.Parse(contenido);
            var raiz = documento.RootElement;

            if (raiz.TryGetProperty("mensaje", out var mensaje) && mensaje.ValueKind == JsonValueKind.String)
                return mensaje.GetString()!;

            if (raiz.TryGetProperty("errors", out var errores) && errores.ValueKind == JsonValueKind.Object)
            {
                var lista = errores.EnumerateObject()
                    .SelectMany(e => e.Value.EnumerateArray())
                    .Select(v => v.GetString())
                    .Where(t => !string.IsNullOrWhiteSpace(t))
                    .ToList();

                if (lista.Any()) return string.Join(" ", lista);
            }
        }
        catch
        {
        }
        return porDefecto;
    }

    public class PuestoModel
    {
        public short IdPuesto { get; set; }
        public string Nombre { get; set; } = "";
    }

    public class EmpleadoModel : IValidatableObject
    {
        public int IdEmpleado { get; set; }

        [Required(ErrorMessage = "Los nombres son obligatorios")]
        [StringLength(60, ErrorMessage = "Máximo 60 caracteres")]
        [RegularExpression(@"^[A-Za-zÁÉÍÓÚáéíóúÑñÜü ]+$", ErrorMessage = "Los nombres solo pueden contener letras")]
        public string Nombres { get; set; } = "";

        [Required(ErrorMessage = "Los apellidos son obligatorios")]
        [StringLength(60, ErrorMessage = "Máximo 60 caracteres")]
        [RegularExpression(@"^[A-Za-zÁÉÍÓÚáéíóúÑñÜü ]+$", ErrorMessage = "Los apellidos solo pueden contener letras")]
        public string Apellidos { get; set; } = "";

        [StringLength(80, ErrorMessage = "Máximo 80 caracteres")]
        public string? Direccion { get; set; }

        [RegularExpression(@"^([0-9]{8})?$", ErrorMessage = "El teléfono debe tener exactamente 8 dígitos")]
        public string? Telefono { get; set; }

        [Required(ErrorMessage = "El DPI es obligatorio")]
        [RegularExpression(@"^[0-9]{13}$", ErrorMessage = "El DPI debe tener exactamente 13 dígitos")]
        public string Dpi { get; set; } = "";

        // Lo que se elige en el combo ("1" = Masculino, "0" = Femenino). No se envía a la API.
        [JsonIgnore]
        [Required(ErrorMessage = "Seleccione el género")]
        public string? GeneroSeleccion { get; set; }

        // Lo que se envía/recibe de la API (columna bit(1)).
        public ulong Genero
        {
            get => GeneroSeleccion == "1" ? 1UL : 0UL;
            set => GeneroSeleccion = value == 1 ? "1" : "0";
        }

        [Required(ErrorMessage = "La fecha de nacimiento es obligatoria")]
        public DateOnly? FechaNacimiento { get; set; }

        [Range(1, short.MaxValue, ErrorMessage = "Seleccione un puesto")]
        public short IdPuesto { get; set; }

        [Required(ErrorMessage = "La fecha de inicio de labores es obligatoria")]
        public DateOnly? FechaInicioLabores { get; set; }

        public DateTime FechaIngreso { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext contexto)
        {
            var hoy = DateOnly.FromDateTime(DateTime.Today);

            if (FechaNacimiento is not null)
            {
                if (FechaNacimiento > hoy.AddYears(-18))
                    yield return new ValidationResult("El empleado debe ser mayor de edad (18 años o más).",
                        new[] { nameof(FechaNacimiento) });
                else if (FechaNacimiento < hoy.AddYears(-100))
                    yield return new ValidationResult("La fecha de nacimiento no es válida.",
                        new[] { nameof(FechaNacimiento) });
            }

            if (FechaInicioLabores is not null)
            {
                if (FechaInicioLabores > hoy)
                    yield return new ValidationResult("La fecha de inicio de labores no puede ser futura.",
                        new[] { nameof(FechaInicioLabores) });
                else if (FechaNacimiento is not null && FechaInicioLabores <= FechaNacimiento)
                    yield return new ValidationResult("Debe ser posterior a la fecha de nacimiento.",
                        new[] { nameof(FechaInicioLabores) });
            }
        }
    }
}
