@page "/reportes/compras"
@inject HttpClient Http
@inject SesionUsuario Sesion
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Reporte de compras</PageTitle>

<h3 class="mb-3">Reporte de compras</h3>

@if (mensajeError is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

<div class="card mb-3 d-print-none">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Desde</label>
                <input type="date" class="form-control" @bind="desde" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" @bind="hasta" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Proveedor</label>
                <select class="form-select" @bind="idProveedor">
                    <option value="0">Todos</option>
                    @foreach (var p in proveedores)
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-primary" @onclick="Consultar" disabled="@cargando">
                @(cargando ? "Consultando..." : "Consultar")
            </button>
            <button class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar filtros</button>
            <button class="btn btn-outline-dark" @onclick="Imprimir" disabled="@(reporte is null)">Imprimir</button>
            <a class="btn btn-link" href="/compras">Ir a Compras</a>
        </div>
    </div>
</div>

@if (reporte is not null)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>No. orden</th>
                    <th>Proveedor</th>
                    <th>Productos</th>
                    <th class="text-end">Unidades</th>
                    <th class="text-end">Total Compra</th>
                </tr>
            </thead>
            <tbody>
                @if (!reporte.Compras.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">No hay compras en el rango seleccionado</td></tr>
                }
                else
                {
                    @foreach (var c in reporte.Compras)
                    {
                        <tr>
                            <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@c.NoOrdenCompra</td>
                            <td>@c.Proveedor</td>
                            <td>
                                @foreach (var p in c.Productos)
                                {
                                    <div class="small">
                                        @p.Cantidad × @p.Producto
                                        <span class="text-muted">(@Q(p.PrecioCostoUnitario) c/u = @Q(p.Subtotal))</span>
                                    </div>
                                }
                            </td>
                            <td class="text-end">@c.Unidades</td>
                            <td class="text-end">@Q(c.TotalCompra)</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4" class="text-end">Total general (@reporte.CantidadCompras compras)</th>
                    <th class="text-end">@reporte.TotalUnidades</th>
                    <th class="text-end">@Q(reporte.TotalGeneral)</th>
                </tr>
            </tfoot>
        </table>
    </div>
}
else if (cargando)
{
    <p><em>Cargando...</em></p>
}

@code {
    private ReporteModel? reporte;
    private List<OpcionModel> proveedores = new();

    private DateTime? desde;
    private DateTime? hasta;
    private int idProveedor;

    private bool cargando = true;
    private string? mensajeError;

    private static string Q(decimal valor) =>
        "Q" + valor.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            proveedores = await Obtener<List<OpcionModel>>("Compras/proveedores") ?? new();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }

        await Consultar();
    }

    private async Task Consultar()
    {
        mensajeError = null;

        if (desde.HasValue && hasta.HasValue && desde.Value.Date > hasta.Value.Date)
        {
            mensajeError = "La fecha inicial no puede ser mayor que la fecha final.";
            return;
        }

        var filtros = new List<string>();
        if (desde.HasValue) filtros.Add($"desde={desde.Value:yyyy-MM-dd}");
        if (hasta.HasValue) filtros.Add($"hasta={hasta.Value:yyyy-MM-dd}");
        if (idProveedor > 0) filtros.Add($"idProveedor={idProveedor}");

        var ruta = "reportes/compras" + (filtros.Count > 0 ? "?" + string.Join("&", filtros) : "");

        cargando = true;
        try
        {
            reporte = await Obtener<ReporteModel>(ruta);
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo conectar con la API: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Limpiar()
    {
        desde = null;
        hasta = null;
        idProveedor = 0;
        await Consultar();
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("print");
    }

    private async Task<T?> Obtener<T>(string ruta) where T : class
    {
        var respuesta = await Http.GetAsync(ruta);

        if (respuesta.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Sesion.Cerrar();
            Nav.NavigateTo("/login");
            return null;
        }

        if (!respuesta.IsSuccessStatusCode)
        {
            try
            {
                var error = await respuesta.Content.ReadFromJsonAsync<ErrorApi>();
                mensajeError = error?.Mensaje ?? "No se pudo cargar el reporte.";
            }
            catch
            {
                mensajeError = "No se pudo cargar el reporte.";
            }
            return null;
        }

        return await respuesta.Content.ReadFromJsonAsync<T>();
    }

    private record ErrorApi(string? Mensaje);

    public class OpcionModel
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
    }

    public class ReporteModel
    {
        public int CantidadCompras { get; set; }
        public int TotalUnidades { get; set; }
        public decimal TotalGeneral { get; set; }
        public List<FilaModel> Compras { get; set; } = new();
    }

    public class FilaModel
    {
        public DateOnly Fecha { get; set; }
        public int NoOrdenCompra { get; set; }
        public string Proveedor { get; set; } = "";
        public int Unidades { get; set; }
        public decimal TotalCompra { get; set; }
        public List<ProductoFilaModel> Productos { get; set; } = new();
    }

    public class ProductoFilaModel
    {
        public string Producto { get; set; } = "";
        public int Cantidad { get; set; }
        public decimal PrecioCostoUnitario { get; set; }
        public decimal Subtotal { get; set; }
    }
}
